{
  "name": "discord-fish-voice-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "register-commands": "tsx scripts/registerCommands.ts",
    "test:integration": "tsx scripts/liveIntegration.ts"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.0",
    "@msgpack/msgpack": "^3.1.3",
    "better-sqlite3": "^12.2.0",
    "discord.js": "^14.22.1",
    "pino": "^9.9.4",
    "prism-media": "^1.3.5",
    "ws": "^8.21.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.34.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "tar": "^7.5.19"
  }
}
