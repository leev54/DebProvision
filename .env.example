# Required
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
FISH_API_KEY=
DATABASE_URL=file:/data/bot.db

# Optional authorization and tuning
BOT_ADMIN_ROLE_ID=
MAX_TRAINING_STORAGE_MB=2000
MAX_SAMPLES_PER_VOICE=200
MAX_SELECTED_TRAINING_DURATION_SECONDS=600
AUTO_KEEP_BEST_SAMPLE=true
AUTO_SUGGEST_BEST_SAMPLE=true
BEST_SAMPLE_MIN_SECONDS=8
BEST_SAMPLE_MAX_SECONDS=30
BEST_SAMPLE_MIN_SCORE=0.78
MAX_LIVE_LAG_MS=3000
MAX_LIVE_UTTERANCE_MS=120000
FISH_REALTIME_TIMEOUT_MS=60000
MAX_TTS_TEXT_LENGTH=1000

# Optional integration-test inputs (not used by the production container)
FISH_TEST_VOICE_ID=
FISH_TEST_REFERENCE_FILE=
FISH_TEST_REFERENCE_TEXT=
FISH_TEST_OUTPUT_FILE=/data/fish-smoke.mp3
